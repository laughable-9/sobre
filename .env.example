# Copy to .env (gitignored) and fill in your own identities.
# Generate fresh testnet keys with:
#   stellar keys generate alice --network testnet --fund
#   stellar keys generate bob   --network testnet --fund
# Then read the seed phrase from ~/.config/stellar/identity/<name>.toml.

# ─── Network ──────────────────────────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# ─── Alice (primary dev identity, factory + sobre admin) ──────────────
ALICE_PUBLIC=G...
ALICE_SEED_PHRASE="your seed phrase here"

# ─── Bob (second member for join + multi-Sobre testing) ───────────────
BOB_PUBLIC=G...
BOB_SEED_PHRASE="your seed phrase here"

# ─── Deployed testnet contract IDs ────────────────────────────────────
SOBRE_FACTORY_TESTNET=C...
XLM_SAC_TESTNET=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
