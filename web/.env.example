# --------------------------------------------------------------------------
# Sobre web — environment template.
# Copy this file to `.env.local` and fill in the Supabase values.
# Stellar testnet config + smart-account-kit constants live in
# web/src/lib/config.ts (so the testnet↔mainnet flip is one file).
# --------------------------------------------------------------------------

# Supabase (auth + off-chain state). Values are per-project; create one at
# supabase.com and grab these from Project Settings → API. The anon /
# publishable key is safe to ship to the browser (RLS gates writes).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. SERVER-ONLY — never NEXT_PUBLIC_. Used by /api/pdax/*
# routes (and any future system writes) to bypass RLS for webhook-driven
# updates. Find in Supabase Dashboard → Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=

# PDAX institutional credentials (SERVER-ONLY — never NEXT_PUBLIC_).
# Issued by PDAX once the Technical Access Form is signed. UAT base URL is
# the default; flip to stage/prod by setting PDAX_BASE_URL explicitly.
PDAX_USERNAME=
PDAX_PASSWORD=
# Optional override. Defaults to UAT: https://uat.services.sandbox.pdax.ph/api/pdax-api
PDAX_BASE_URL=
# Set MOCK_PDAX=true to return canned responses without calling PDAX. Useful
# while UAT credentials are arriving or for tests.
MOCK_PDAX=false
# Random secret embedded in the webhook URL we register with PDAX (PDAX
# doesn't sign payloads). Anything PDAX-unaware → drop on the floor.
PDAX_WEBHOOK_SECRET=
