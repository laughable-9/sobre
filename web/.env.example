# --------------------------------------------------------------------------
# Sobre web — environment template.
# Copy this file to `.env.local`. All values below are shared testnet
# artifacts (no secrets); same for every Sobre dev.
# --------------------------------------------------------------------------

# Stellar testnet RPC + network passphrase.
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Smart-account-kit pre-uploaded testnet WASM + verifier C-addresses.
# Shared across every smart-account-kit user on testnet; nothing for us to
# deploy at the smart-wallet layer.
NEXT_PUBLIC_ACCOUNT_WASM_HASH=8537b8166c0078440a5324c12f6db48d6340d157c306a54c5ea81405abcc2611
NEXT_PUBLIC_WEBAUTHN_VERIFIER_ADDRESS=CCMR63YE5T7MPWREF3PC5XNTTGXFSB4GYUGUIT5POHP2UGCS65TBIUUU
NEXT_PUBLIC_ED25519_VERIFIER_ADDRESS=CCJOUKLCZVCXS4VIBBEA7S3SPWZQS5DPE5A4YG67RA3Z7E3SJZAUJFQA

# Native XLM SAC on testnet (deterministic per network).
NEXT_PUBLIC_NATIVE_TOKEN_CONTRACT=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
