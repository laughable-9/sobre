# --------------------------------------------------------------------------
# Sobre web — environment template.
# Copy this file to `.env.local` and fill in the Supabase values.
# Stellar testnet config + smart-account-kit constants live in
# web/src/lib/config.ts (so the testnet↔mainnet flip is one file).
# --------------------------------------------------------------------------

# Supabase (auth + off-chain state). Values are per-project; create one at
# supabase.com and grab these from Project Settings → API. The anon /
# publishable key is safe to ship to the browser (RLS gates writes).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
